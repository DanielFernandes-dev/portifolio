---
import { projects } from "../../lib/projects"
---
    <section class="max-w-[1280px] mx-auto px-gutter py-stack-gap">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 glass-panel p-8 md:p-12 rounded-xl">
          <h2 class="text-headline-md mb-6 text-primary">Sobre Mim</h2>
          <p class="font-body-base text-body-base text-on-surface-variant mb-6">
            Sou sócio na Chronokairo e construo projetos para aprender na prática. Meus repositórios públicos incluem um blog com React e Firebase, um editor com API em Python, um aplicativo de organização e uma visual novel para web e Android. Também exploro interfaces e páginas em HTML.
          </p>
          <div class="flex flex-wrap gap-3 mb-6">
            {["HTML", "CSS", "JavaScript", "TypeScript", "Astro", "Python", "Firebase"].map(
              (skill) => (
                <span
                  class="px-3 py-1 bg-primary/10 border border-primary/20 text-primary text-[11px] font-code-sm rounded"
                >
                  {skill}
                </span>
              )
            )}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-white/5">
            <div>
              <span class="block text-headline-md text-secondary">{projects.length}</span>
              <span class="font-label-caps text-label-caps text-outline">Projetos públicos</span>
            </div>
            <div>
              <span class="block text-headline-md text-secondary">3</span>
              <span class="font-label-caps text-label-caps text-outline">Frentes de estudo</span>
            </div>
            <div>
              <span class="block text-headline-md text-secondary">Web + Android</span>
              <span class="font-label-caps text-label-caps text-outline">Plataformas</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 space-y-6">
          <div class="glass-panel p-6 rounded-xl">
            <div class="flex justify-between items-center mb-6">
              <h3 class="font-label-caps text-label-caps text-primary">O que tenho construído</h3>
              <span class="material-symbols-outlined text-secondary">query_stats</span>
            </div>
            <div class="space-y-4">
              {[
                { area: "Web", detail: "Blog, editor e estudos de interface" },
                { area: "Aplicativos", detail: "Organização de conhecimento com Tauri" },
                { area: "Jogos", detail: "Visual novel para navegador e Android" },
              ].map((item) => (
                <div class="flex flex-col gap-1 border-b border-white/5 pb-3 last:border-0 last:pb-0">
                  <span class="font-code-sm text-code-sm text-on-surface">{item.area}</span>
                  <span class="font-body-base text-sm text-on-surface-variant">{item.detail}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-surface-container-high p-6 rounded-xl border border-white/10">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-secondary/20 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1">
                  terminal
                </span>
              </div>
              <div>
                <p class="font-label-caps text-label-caps text-outline mb-1">Projeto em destaque</p>
                <p class="font-body-base text-body-base">SANMD: visual novel investigativa para web e Android</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

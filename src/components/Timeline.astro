---
import { activityMonths } from "../../lib/activityMonths"

const MONTHS_PT = [
  "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
  "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro",
]


const years = [...new Set(activityMonths.map((item) => item.year))]
---
    <section class="max-w-[1280px] mx-auto px-gutter py-stack-gap scroll-mt-20" id="timeline">
      <div class="rounded-[28px] border border-white/10 bg-surface-container-low px-6 py-8 sm:px-10 lg:px-12 lg:py-10">
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-on-surface mb-9">Meses ativos</h2>

        <div class="space-y-9">
          {years.map((year) => (
              <div aria-labelledby={`active-year-${year}`}>
                <div class="flex items-center gap-4 mb-5">
                  <h3 id={`active-year-${year}`} class="font-code-sm text-sm text-secondary">{year}</h3>
                  <div class="h-px flex-1 bg-outline-variant/60" aria-hidden="true" />
                </div>
                <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  {activityMonths.filter((item) => item.year === year).map((item) => (
                    <li
                      class="min-h-32 rounded-2xl border border-white/10 bg-surface-container/70 p-5 flex flex-col justify-between"
                    >
                      <div class="flex items-start justify-between gap-3">
                        <span class="font-code-sm text-xs tracking-widest text-outline">
                          {String(item.month).padStart(2, "0")} / {item.year}
                        </span>
                        <span class="material-symbols-outlined text-xl text-primary/70" aria-hidden="true">
                          commit
                        </span>
                      </div>
                      <span class="block text-xl font-semibold text-on-surface">{MONTHS_PT[item.month - 1]}</span>
                    </li>
                  ))}
                </ol>
              </div>
          ))}
        </div>
      </div>
    </section>

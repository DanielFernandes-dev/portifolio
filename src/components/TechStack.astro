---
const stacks = [
  { icon: "deployed_code", name: "Frontend", tech: "Astro, Tailwind" },
  { icon: "dns", name: "Backend", tech: "Python, FastAPI, SQLite" },
  { icon: "code", name: "Linguagens", tech: "JavaScript, TypeScript" },
  { icon: "web", name: "Web", tech: "HTML, CSS, DOM API" },
  { icon: "neurology", name: "Dados", tech: "Firebase Auth, Firestore" },
  { icon: "construction", name: "Apps", tech: "Tauri, Capacitor" },
]
---
    <section class="max-w-[1280px] mx-auto px-gutter py-stack-gap" aria-labelledby="technologies-title">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <p class="font-label-caps text-label-caps text-secondary mb-3">Experiência prática</p>
        <h2 id="technologies-title" class="text-headline-md mb-4 text-on-surface">Tecnologias usadas</h2>
        <p class="font-body-base text-body-base text-on-surface-variant">
          Ferramentas que usei em projetos e estudos. Sigo aprendendo os fundamentos teóricos na graduação e colocando esse aprendizado em prática.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {stacks.map((s) => (
          <div
            class="glass-panel p-6 rounded-xl text-center group hover:border-primary/50 transition-colors"
          >
            <span class="material-symbols-outlined text-primary text-4xl mb-3 block">{s.icon}</span>
            <h4 class="font-label-caps text-label-caps mb-2">{s.name}</h4>
            <p class="text-[10px] text-outline font-code-sm">{s.tech}</p>
          </div>
        ))}
      </div>
    </section>

---
import { projects } from "../../lib/projects"
---
    <section class="max-w-[1280px] mx-auto px-gutter py-stack-gap" id="projects">
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between sm:items-end mb-12">
        <div>
          <h2 class="text-headline-md text-on-surface">Projetos</h2>
          <p class="text-on-surface-variant font-body-base">{projects.length} repositórios públicos. Diário do Dev e SANMD estão em destaque.</p>
        </div>
        <a
          href="https://github.com/DanielFernandes-dev"
          class="text-primary font-label-caps hover:underline"
        >
          Ver Todos
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        {projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`${p.span} group relative rounded-xl overflow-hidden glass-panel flex flex-col border transition-all p-6 backdrop-blur-md ${p.featured ? "border-primary/50 bg-primary/5 shadow-[0_0_32px_rgba(173,198,255,0.08)] hover:border-secondary/70" : "border-white/10 bg-surface-container/90 hover:border-primary/40"}`}
          >
            <div class="relative aspect-video -mx-6 -mt-6 mb-6 overflow-hidden bg-surface-container-high border-b border-white/10">
              <img
                src={p.preview}
                alt={p.previewAlt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <span class="absolute bottom-3 left-3 rounded bg-background/85 px-3 py-1 font-code-sm text-xs text-on-surface backdrop-blur-sm">
                Prévia do projeto
              </span>
              {p.featured && (
                <span class="absolute top-3 left-3 rounded-full border border-secondary/40 bg-background/90 px-3 py-1 font-code-sm text-xs font-semibold text-secondary backdrop-blur-sm">
                  Em destaque
                </span>
              )}
            </div>
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-headline-md text-on-surface group-hover:text-primary transition-colors">
                {p.title}
              </h3>
              <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors">
                open_in_new
              </span>
            </div>
            <p class="font-body-base text-sm text-on-surface-variant mb-5 flex-1">{p.description}</p>
            <div class="border-t border-white/10 pt-4">
              <p class="font-label-caps text-label-caps text-secondary mb-3">Tecnologias usadas</p>
              <ul class="flex gap-2 flex-wrap" aria-label={`Tecnologias usadas em ${p.title}`}>
                {p.tags.map((tag) => (
                  <li class="px-3 py-1.5 bg-primary/10 border border-primary/30 text-primary text-xs font-code-sm rounded-md">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </a>
        ))}
      </div>
    </section>

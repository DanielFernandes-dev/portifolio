---

---
    <section class="relative min-h-[921px] flex items-center justify-center overflow-hidden px-gutter">
      <div class="relative z-10 text-center max-w-4xl mx-auto">
        <img
          src="https://avatars.githubusercontent.com/u/239253498?v=4"
          alt="Daniel Fernandes"
          loading="lazy"
          decoding="async"
          class="w-28 h-28 md:w-36 md:h-36 rounded-full mx-auto mb-6 border-2 border-primary/50"
        />
        <h1 class="text-display-lg-mobile md:text-display-lg mb-4 text-on-surface">
          Daniel Fernandes
        </h1>
        <p class="font-code-sm text-code-sm text-secondary tracking-widest uppercase mb-8">
          Sócio na Chronokairo | Desenvolvimento web • Aplicativos • Jogos
        </p>
        <div class="mb-12" />
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="#projects"
            class="bg-primary text-on-primary px-8 py-3 rounded-lg font-bold hover:scale-105 active:scale-95 transition-all inline-block"
          >
            Explorar Projetos
          </a>
          <a
            href="https://github.com/DanielFernandes-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-panel text-on-surface px-8 py-3 rounded-lg font-bold hover:bg-surface-container-high transition-all inline-block"
          >
            GitHub
          </a>
          <a
            href="#footer"
            class="glass-panel text-on-surface px-8 py-3 rounded-lg font-bold hover:bg-surface-container-high transition-all inline-block"
          >
            Entrar em Contato
          </a>
        </div>
      </div>
    </section>

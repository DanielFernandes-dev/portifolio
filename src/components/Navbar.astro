---
const navLinks = [
  { href: "#projects", label: "Projetos" },
  { href: "#timeline", label: "Meses ativos" },
]
---
    <nav class="fixed top-0 w-full z-50 bg-background/70 backdrop-blur-md border-b border-white/10">
      <div class="flex justify-center items-center max-w-[1280px] mx-auto px-gutter h-16">
        <div class="flex gap-6 items-center">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-on-surface-variant font-body-base hover:text-primary transition-colors duration-200"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

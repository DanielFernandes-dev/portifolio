---
import "../styles/global.css"
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página não encontrada | Daniel Fernandes</title>
    <meta name="description" content="Esta página não existe no portfólio de Daniel Fernandes." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background text-on-background flex items-center justify-center px-gutter">
    <main class="max-w-xl text-center">
      <p class="font-code-sm text-secondary mb-4">Erro 404</p>
      <h1 class="text-display-lg-mobile md:text-display-lg mb-6">Página não encontrada</h1>
      <p class="text-on-surface-variant mb-8">O endereço que você acessou não existe neste portfólio.</p>
      <a href="/" class="inline-block bg-primary text-on-primary px-8 py-3 rounded-lg font-bold hover:scale-105 transition-transform">Voltar ao início</a>
    </main>
  </body>
</html>
